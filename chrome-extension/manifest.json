{
  "manifest_version": 3,
  "name": "TruthWeave",
  "version": "1.0.0",
  "description": "AI-powered misinformation detection for social media content",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
